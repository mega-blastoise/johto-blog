{
  "name": "@prize-map/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run bundle && bun run declarations",
    "bundle": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --packages external --sourcemap=external",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "declarations": "tsc --emitDeclarationOnly",
    "test": "bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
