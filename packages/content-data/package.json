{
  "name": "@prize-map/content-data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build.ts && bun run declarations",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist",
    "declarations": "tsc --emitDeclarationOnly",
    "lint": "eslint src build.ts",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@prize-map/content": "workspace:*",
    "@prize-map/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
