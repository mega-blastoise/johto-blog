{
  "name": "@prize-map/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "fmt": "prettier --write . --ignore-unknown",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint eslint.config.js",
    "start": "turbo run start",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24"
  }
}
